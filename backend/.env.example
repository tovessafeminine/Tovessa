# Use a Gmail address + App Password (NOT your normal Gmail password)
# Enable 2FA on Gmail â†’ Google Account â†’ Security â†’ App Passwords â†’ Create one
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-character-app-password
